# ==============================================================================
# MECNUN STUDIO — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Duplicate this file as .env.local and configure your environment secrets.
# NEVER commit .env.local, API keys, or production credentials to Git.
# ==============================================================================

# Core Application URL
NEXT_PUBLIC_SITE_URL=https://mecnun.dev

# Production Environment
NODE_ENV=production

# Email Service Integration (e.g. Resend / SendGrid / AWS SES)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_NOTIFICATION_EMAIL=contact@mecnunum.com

# Anti-Spam / Rate Limiting Token Secret
# RATE_LIMIT_SECRET=your_super_secret_rate_limit_token_here

# Analytics & Monitoring (Optional Privacy-First Telemetry)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
